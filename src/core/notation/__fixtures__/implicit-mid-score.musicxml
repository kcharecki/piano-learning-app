<?xml version="1.0" encoding="UTF-8"?>
<!-- 4/4, divisions=1. A double barline splits the piece into two sections and the
     second section opens with a one-beat anacrusis, which MusicXML writes as a
     SHORT measure carrying implicit="yes" in the MIDDLE of the score:
       bar 1  C4 D4 E4 F4 quarters        ticks 0 480 960 1440      len 1920
       bar 2  G4 A4 B4 C5 quarters        ticks 1920 2400 2880 3360 len 1920  ||
       bar 0  D5 quarter (implicit)       tick  3840                len  480
       bar 3  E5 F5 G5 A5 quarters        ticks 4320 4800 5280 5760 len 1920
     The implicit bar must stay 480 ticks long — its content — not be padded out
     to the 1920-tick metre, or every barline after it shifts by 1440 ticks.
     Total: 1920 + 1920 + 480 + 1920 = 6240 ticks. -->
<score-partwise version="4.0">
  <work><work-title>Implicit Mid Score</work-title></work>
  <part-list>
    <score-part id="P1"><part-name>Piano</part-name></score-part>
  </part-list>
  <part id="P1">
    <measure number="1">
      <attributes>
        <divisions>1</divisions>
        <key><fifths>0</fifths></key>
        <time><beats>4</beats><beat-type>4</beat-type></time>
        <clef><sign>G</sign><line>2</line></clef>
      </attributes>
      <note><pitch><step>C</step><octave>4</octave></pitch><duration>1</duration><type>quarter</type></note>
      <note><pitch><step>D</step><octave>4</octave></pitch><duration>1</duration><type>quarter</type></note>
      <note><pitch><step>E</step><octave>4</octave></pitch><duration>1</duration><type>quarter</type></note>
      <note><pitch><step>F</step><octave>4</octave></pitch><duration>1</duration><type>quarter</type></note>
    </measure>
    <measure number="2">
      <note><pitch><step>G</step><octave>4</octave></pitch><duration>1</duration><type>quarter</type></note>
      <note><pitch><step>A</step><octave>4</octave></pitch><duration>1</duration><type>quarter</type></note>
      <note><pitch><step>B</step><octave>4</octave></pitch><duration>1</duration><type>quarter</type></note>
      <note><pitch><step>C</step><octave>5</octave></pitch><duration>1</duration><type>quarter</type></note>
      <barline location="right"><bar-style>light-light</bar-style></barline>
    </measure>
    <measure number="0" implicit="yes">
      <note><pitch><step>D</step><octave>5</octave></pitch><duration>1</duration><type>quarter</type></note>
    </measure>
    <measure number="3">
      <note><pitch><step>E</step><octave>5</octave></pitch><duration>1</duration><type>quarter</type></note>
      <note><pitch><step>F</step><octave>5</octave></pitch><duration>1</duration><type>quarter</type></note>
      <note><pitch><step>G</step><octave>5</octave></pitch><duration>1</duration><type>quarter</type></note>
      <note><pitch><step>A</step><octave>5</octave></pitch><duration>1</duration><type>quarter</type></note>
    </measure>
  </part>
</score-partwise>
