{
  "permissions": {
    "allow": [
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm run verify:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run build:*)",
      "Bash(npm run checkpoint:*)",
      "Bash(npx vitest:*)",
      "Bash(npx tsc:*)",
      "Bash(npx eslint:*)",
      "Bash(npx prettier:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git show:*)",
      "PowerShell(npm test:*)",
      "PowerShell(npm run test:*)",
      "PowerShell(npm run verify:*)",
      "PowerShell(npx vitest:*)",
      "PowerShell(git status:*)",
      "PowerShell(git log:*)",
      "PowerShell(git diff:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -Command \"if (git status --porcelain) { 'TREE DIRTY at session start. Recovery is protocol step 0, before any roadmap work: npm run verify; green -> commit leftovers in module-sized slices; red -> fixing it is the next task. See docs/efficiency-guide.md section 5.' }\""
          }
        ]
      }
    ]
  }
}
