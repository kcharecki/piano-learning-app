{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["scripts/*.mjs"],
  "project": [
    "src/**/*.{ts,tsx}!",
    "!src/**/*.test.{ts,tsx}!",
    "!src/test/**!",
    "scripts/**/*.mjs"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "types": "off"
  },
  // Domain modules that are finished and tested but that no screen renders YET. Every entry names
  // the roadmap task that will wire it: when that task lands, DELETE the line — a permanent entry
  // here is how "green tests, never executed" hides. Nothing may be added without a task id.
  //
  // EMPTY, and that is the point: roadmap 4.9b (the lesson screen) was the last consumer owed, and
  // it landed. `core/curriculum/model.ts`, `content/curriculum/*` and `content/scores/demoScores.ts`
  // are now reachable from `src/main.tsx`, so knip's production mode guards them like everything
  // else. Do not add an entry here without a roadmap task id and a deletion condition.
  "ignore": []
}
