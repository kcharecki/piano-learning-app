{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["scripts/*.mjs"],
  "project": [
    "src/**/*.{ts,tsx}!",
    "!src/**/*.test.{ts,tsx}!",
    "!src/test/**!",
    "scripts/**/*.mjs"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "types": "off"
  },
  // Domain modules that are finished and tested but that no screen renders YET. Every entry names
  // the roadmap task that will wire it: when that task lands, DELETE the line — a permanent entry
  // here is how "green tests, never executed" hides. Nothing may be added without a task id.
  "ignore": [
    // roadmap 4.9b — the lesson screen. `CURRICULUM` is now authored (4.9) and
    // `curriculum.test.ts` runs `validateCurriculum` over it, but a test is not
    // production reachability: under --production nothing imports either the
    // content or the validator. Both lines go when the lesson screen renders
    // `CURRICULUM`; neither may outlive 4.9b.
    "src/core/curriculum/model.ts",
    "src/content/curriculum/*.ts",
    // roadmap 4.9b — the demonstrations each lesson names via `demoScoreId`.
    // Reachable only once the lesson screen engraves them.
    "src/content/scores/demoScores.ts"
  ]
}
