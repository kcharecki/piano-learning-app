{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["scripts/*.mjs"],
  "project": [
    "src/**/*.{ts,tsx}!",
    "!src/**/*.test.{ts,tsx}!",
    "!src/test/**!",
    "scripts/**/*.mjs"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "types": "off"
  },
  // Domain modules that are finished and tested but that no screen renders YET. Every entry names
  // the roadmap task that will wire it: when that task lands, DELETE the line — a permanent entry
  // here is how "green tests, never executed" hides. Nothing may be added without a task id.
  "ignore": [
    // roadmap 4.9 — the shipped curriculum content this validates. Nothing
    // authors a Curriculum yet, so nothing calls the validator.
    "src/core/curriculum/model.ts",
    // roadmap 4.6a — the export/import screen (a file picker and a download button)
    "src/core/progress/export.ts",
    // roadmap 4.4a — the technique drill screen. `candidates.ts` deliberately
    // emits no technique exercise until it exists, rather than planning a
    // session item nothing can open.
    "src/core/technique/library.ts",
    // roadmap 3.2a — showing the roman-numeral analysis under the score
    "src/core/theory/analysis.ts"
  ]
}
