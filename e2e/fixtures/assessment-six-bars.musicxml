<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE score-partwise PUBLIC "-//Recordare//DTD MusicXML 4.0 Partwise//EN" "http://www.musicxml.org/dtds/partwise.dtd">
<!--
  Assessment six-bar fixture (roadmap 2.11 e2e — see e2e/assessment.spec.ts).
  One part, treble clef, right hand only, 4/4, <sound tempo="120"/> so one
  quarter note is exactly 500ms and the whole six-bar run is exactly 12s.
  Four quarter notes per measure, natural pitches only (no accidentals), all
  within one octave around middle C (C4..C5), no ties, no rests, no chords.
  Every measure uses four DISTINCT pitches so a wrong note played against it
  is unambiguous. Modelled on
  src/content/scores/twinkle-twinkle-little-star.musicxml's element shape
  (single <divisions>, <sound tempo> on the first measure, one <part>) so
  parseMusicXml accepts it the same way.
-->
<score-partwise version="4.0">
  <work>
    <work-title>Assessment Six-Bar Fixture</work-title>
  </work>
  <identification>
    <creator type="composer">E2E Fixture</creator>
  </identification>
  <part-list>
    <score-part id="P1">
      <part-name>Piano</part-name>
    </score-part>
  </part-list>
  <part id="P1">
    <measure number="1">
      <attributes>
        <divisions>1</divisions>
        <key><fifths>0</fifths></key>
        <time><beats>4</beats><beat-type>4</beat-type></time>
        <clef><sign>G</sign><line>2</line></clef>
      </attributes>
      <sound tempo="120"/>
      <note><pitch><step>C</step><octave>4</octave></pitch><duration>1</duration><voice>1</voice><type>quarter</type><staff>1</staff></note>
      <note><pitch><step>D</step><octave>4</octave></pitch><duration>1</duration><voice>1</voice><type>quarter</type><staff>1</staff></note>
