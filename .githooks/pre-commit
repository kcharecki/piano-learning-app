#!/bin/sh
# Enforces "never commit red" in automation rather than in prose.
# Bypass is possible with --no-verify, but CLAUDE.md forbids it — if this hook
# fails, fix the code, do not route around it.
set -e

# First, because it is the cheapest and the one a session is most likely to
# have skipped. Silent unless the commit stages a component or a stylesheet.
echo "pre-commit: visual pass receipt"
npm run --silent check:visual

echo "pre-commit: typecheck"
npm run --silent typecheck

echo "pre-commit: lint"
npm run --silent lint

echo "pre-commit: core tests"
npm run --silent test

echo "pre-commit: ok"
