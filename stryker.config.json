{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "coverageAnalysis": "perTest",
  "concurrency": 4,
  "mutate": ["src/core/**/*.ts", "!src/core/**/*.test.ts"],
  "ignoreStatic": true,
  "reporters": ["clear-text", "progress", "html"],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  }
}
